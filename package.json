  "version": "3.1.0",
  "description": "A tool to generate commit messages and commands for git",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "git-cmg": "dist/index.js",
    "git-commit-msg-generate": "dist/index.js",
