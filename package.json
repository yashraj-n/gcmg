    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/openai": "^1.5.13",
    "@opentui/core": "^0.5.11",
    "chalk": "^6.0.0",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "ignore": "^7.0.9",
    "langchain": "^1.5.11",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "simple-git": "^3.36.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/node": "^26.5.1",
    "@types/prompts": "^2.4.9",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "langsmith": "^0.10.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
